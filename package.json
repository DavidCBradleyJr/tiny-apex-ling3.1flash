{
  "name": "tiny-apex",
  "private": true,
  "version": "1.0.0",
  "description": "Tiny Apex — a one-button arcade racing toy on a miniature desert circuit (Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173",
    "test": "tsc -p tsconfig.test.json && node --test test-dist/"  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
